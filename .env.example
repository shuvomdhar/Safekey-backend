# ---------------------------------------------------------------------------
#  Safekey API — environment variables
#  Copy to .env and fill in the values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# 64 hex characters (32 bytes) used to encrypt every secret field.
# Generate with: npm run keygen
# WARNING: changing this makes existing secrets unreadable.
ENCRYPTION_KEY=

# Where the web app lives — used for CORS.
FRONTEND_URL=http://localhost:3000

# Supabase project (same project as NEXT_PUBLIC_SUPABASE_* in frontend/.env).
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Public anon key: only used to verify the browser's access token.
SUPABASE_ANON_KEY=

# Server-only service-role key. Every Safekey read/write goes through Supabase
# with this key. Never expose it to the browser or commit it.
# Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
